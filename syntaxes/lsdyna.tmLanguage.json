{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "LS-Dyna",
	"scopeName": "source.lsdyna",
	"patterns": [
		{"include": "#include_path_blocks"},
		{"include": "#comments"},
		{"include": "#dyna_numeric"},
		{"include": "#parameter_expression_block"},
		{"include": "#keywords_type"},
		{"include": "#separate"},
		{"include": "#posterior_keywords_and_options"},
		{"include": "#parameter_type"},
		{"include": "#suboptions_with_bracket"},
		{"include": "#names"},
		{"include": "#phrase"}
	],
	"repository": {
		"include_path_blocks": {
			"patterns": [
				{
					"comment": "Repeatable INCLUDE filename and INCLUDE_PATH cards",
					"begin": "^([ \\t]*)((?i:\\*INCLUDE(?:_(?:AUTO_OFFSET|BINARY|COMPENSATION_(?:BEFORE_SPRINGBACK|BLANK_(?:AFTER|BEFORE)_SPRINGBACK|COMPENSATED_SHAPE|COMPENSATED_SHAP_ENEXT_STEP|CURRENT_TOOLS|CURVE|DESIRED_BLANK_SHAPE|NEW_RIGID_TOOL|ORIGINAL_(?:DYNAIN|RIGID_TOOL|TOOL)|SPRINGBACK_INPUTE|TANGENT_CONSTRAINT|TRIM_(?:CURVE|NODE)|UPDATED_(?:BLANK_SHAPE|RIGID_TOOL))|COSIM|EFV|ISPG|PATH(?:_RELATIVE)?|TRIM|WD_(?:FINIAL_PART|INITIAL_BLANK|WELDLINE_CURVE)))?))[ \\t]*\\r?$",
					"beginCaptures": {
						"2": { "name": "keyword.control.lsdyna" }
					},
					"end": "(?=^[ \\t]*\\*)",
					"patterns": [
						{ "include": "#comments" },
						{
							"comment": "Keep numeric prefixes, underscores, separators, and extensions in one path scope",
							"name": "string.unquoted.path.lsdyna",
							"match": "^(?![ \\t]*[$*])(?=.*\\S)[^\\r\\n]+$"
						}
					]
				},
				{
					"comment": "Structured INCLUDE variants whose first data card is a filename",
					"begin": "^([ \\t]*)((?i:\\*INCLUDE_(?:AUTO_OFFSET_USER|NASTRAN|STAMPED_(?:PART(?:_MATRIX(?:_INVERSE)?|_SET|_SOLID_TO_SOLID(?:_GENERAL|_SET_LIST)?)?|SET(?:_MATRIX(?:_INVERSE)?)?)|TRANSFORM(?:_BINARY)?|UNITCELL)))[ \\t]*\\r?$",
					"beginCaptures": {
						"2": { "name": "keyword.control.lsdyna" }
					},
					"end": "(?=^[ \\t]*\\*)|^((?![ \\t]*[$*])(?=.*\\S)(?!.* \\+[ \\t]*\\r?$)[^\\r\\n]+)$",
					"endCaptures": {
						"1": { "name": "string.unquoted.path.lsdyna" }
					},
					"patterns": [
						{ "include": "#comments" },
						{
							"comment": "Filename continuation before the final filename segment",
							"name": "string.unquoted.path.lsdyna",
							"match": "^(?![ \\t]*[$*])(?=.*\\S)[^\\r\\n]+$"
						}
					]
				},
				{
					"comment": "MULTISCALE variants use card 1 for ID and card 2 for filename",
					"begin": "^([ \\t]*)((?i:\\*INCLUDE_MULTISCALE(?:_SPOTWELD)?))[ \\t]*\\r?$",
					"beginCaptures": {
						"2": { "name": "keyword.control.lsdyna" }
					},
					"end": "(?=^[ \\t]*\\*)",
					"patterns": [
						{ "include": "#comments" },
						{
							"comment": "Enter the filename card after the numeric or parameterized ID card",
							"begin": "^([ \\t]*)(?:([&][A-Za-z_][A-Za-z0-9_-]{0,8})|([+\\-]?\\d+))([ \\t]*,?[ \\t]*)\\r?$",
							"beginCaptures": {
								"2": { "name": "variable.parameter.lsdyna" },
								"3": { "name": "constant.numeric.integer.lsdyna" }
							},
							"end": "(?=^[ \\t]*\\*)|^((?![ \\t]*[$*])(?=.*\\S)(?!.* \\+[ \\t]*\\r?$)[^\\r\\n]+)$",
							"endCaptures": {
								"1": { "name": "string.unquoted.path.lsdyna" }
							},
							"patterns": [
								{ "include": "#comments" },
								{
									"name": "string.unquoted.path.lsdyna",
									"match": "^(?![ \\t]*[$*])(?=.*\\S)[^\\r\\n]+$"
								}
							]
						}
					]
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"comment": "Comment line",
					"begin": "^[$]",
					"end": "(?=\\n|\\r)",
					"name": "comment.line.dollar.lsdyna"
				}
			]
		},
		"dyna_numeric": {
			"patterns": [
				{
					"comment": "General Dyna Numbers",
					"name": "constant.numeric.float.decimal.lsdyna",
					"match": "(?:([\\+\\-]*(\\d+\\.*\\d*)([eE][\\-\\+]?\\d+)*))(?=[^A-QS-Za-qs-z_])"
				}
			]
		},
		"separate": {
			"patterns": [
				{
					"comment": "LS-DYNA separate",
					"name": "punctuation.separator.delimiter.lsdyna",
					"begin": "_|\\,",
					"end": "(?=\\w|\\s)"
				}
			]
		},
		"keywords_type": {
			"patterns": [
				{
					"comment": "LS-DYNA keywords type",
					"name": "keyword.control.lsdyna",
					"begin": "^[*]",
					"end": "(?=\\,|\\n|\\r|[ ])"
				}
			]
		},
		"posterior_keywords_and_options": {
			"patterns": [
				{
					"comment": "posterior keywords and options",
					"name": "keyword.control.lsdyna",
					"begin": "(?<=_)\\w",
					"end": "(?=\\n|\\r|[ ])"
				}
			]
		},
		"parameter_type": {
			"patterns": [
				{
					"comment": "LS-DYNA parameter type",
					"name": "variable.parameter.lsdyna",
					"begin": "[&]",
					"end": "(?=\\,|\\n|\\r|[ ])"
				}
			]
		},
		"parameter_expression_block": {
			"comment": "PARAMETER_EXPRESSION block — bare variable refs in expression values",
			"begin": "^(\\*PARAMETER_EXPRESSION[^\\n]*)",
			"beginCaptures": {
				"1": { "name": "keyword.control.lsdyna" }
			},
			"while": "^(?![*])",
			"patterns": [
				{ "include": "#comments" },
				{
					"comment": "expression data line: TYPE name expression",
					"match": "^[RI]\\s+\\w+\\s+(\\S.*$)",
					"captures": {
						"1": {
							"patterns": [
								{
									"match": "[A-Za-z_]\\w*",
									"name": "variable.parameter.lsdyna"
								}
							]
						}
					}
				}
			]
		},
		"suboptions_with_bracket": {
			"patterns": [
				{
					"comment": "suboptions with bracket",
					"name": "variable.other.function.lsdyna",
					"match": "(?<=\\{)\\w*(?=\\})"
				}
			]
        },
        "names":{
            "patterns": [
                {
                "comment": "name",
                "name": "string.unquoted.lsdyna",
                "match": "^([\\S]+)$"
                }
            ]
		},
		"phrase":{
            "patterns": [
                {
                "comment": "Phrase in quotes",
                "name": "string.quoted.double.lsdyna",
                "match": "(\"([^\"]|\"\")*\")"
                }
            ]
        }
	}
}
