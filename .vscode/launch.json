{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DynaSense: Extension Development Host",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "watch debug",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--disable-extensions",
                "--skip-welcome",
                "--skip-release-notes"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ]
        }
    ]
}

