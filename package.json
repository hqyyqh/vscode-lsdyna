            },
            {
                "command": "extension.entityReferences.unpin",
                "title": "%commands.entityReferences.unpin.title%",
                "icon": "$(pinned-dirty)"
            },
            {
                "command": "extension.entityReferences.remove",
                "title": "%commands.entityReferences.remove.title%",
                "icon": "$(close)"
            },
            {
                "command": "extension.entityReferences.clear",
                "title": "%commands.entityReferences.clear.title%",
                "icon": "$(clear-all)"
            },
            {
                "command": "extension.entityReferences.next",
                "title": "%commands.entityReferences.next.title%",
                "icon": "$(arrow-down)"
            },
            {
                "command": "extension.entityReferences.previous",
                "title": "%commands.entityReferences.previous.title%",
                "icon": "$(arrow-up)"
            },
            {
                "command": "extension.entityReferences.openSide",
                "title": "%commands.entityReferences.openSide.title%",
                "icon": "$(split-horizontal)"
            },
            {
                "command": "extension.entityReferences.openCurrent",
                "title": "%commands.entityReferences.openCurrent.title%",
                "icon": "$(go-to-file)"
            },
            {
                "command": "extension.clearProjectIndexCaches",
                "title": "%commands.clearProjectIndexCaches.title%",
                "category": "LS-DYNA"
            },
            {
                "command": "extension.checkKeywordStructure",
                "title": "%commands.checkKeywordStructure.title%",
                "category": "LS-DYNA",
                "enablement": "editorLangId == lsdyna"
            },
            {
                "command": "extension.lsdynaShiftTab",
                "title": "%commands.lsdynaShiftTab.title%"
            },
            {
                "command": "extension.lsdynaSelectCell",
                "title": "%commands.lsdynaSelectCell.title%"
            },
            {
                "command": "extension.lsdynaLineComment",
                "title": "%commands.lsdynaLineComment.title%"
            },
            {
                "command": "extension.lsdynaFormatSelection",
                "title": "%commands.lsdynaFormatSelection.title%",
                "enablement": "editorLangId == 'lsdyna'"
            },
            {
                "command": "extension.addVerifiedConditionalCards",
                "title": "%commands.addVerifiedConditionalCards.title%",
                "category": "LS-DYNA",
                "enablement": "editorLangId == lsdyna"
            },
            {
                "command": "extension.pickOfficialFieldValue",
                "title": "%commands.pickOfficialFieldValue.title%",
                "category": "LS-DYNA",
                "enablement": "editorLangId == lsdyna"
            },
            {
                "command": "extension.lsdynaTab",
                "title": "%commands.lsdynaTab.title%"
            },
            {
                "command": "extension.lsdynaCellDeleteRight",
                "title": "%commands.lsdynaCellDeleteRight.title%"
            },
            {
                "command": "extension.lsdynaCellDeleteLeft",
                "title": "%commands.lsdynaCellDeleteLeft.title%"
            },
            {
                "command": "extension.lsdynaChooseKeywordOptions",
                "title": "%commands.lsdynaChooseKeywordOptions.title%",
                "category": "LS-DYNA"
            },
            {
                "command": "extension.keywordIndexChooseLayout",
                "title": "%commands.keywordIndexChooseLayout.title%",
                "icon": "$(list-selection)"
            },
            {
                "command": "extension.keywordIndexToggleFollow",
                "title": "%commands.keywordIndexToggleFollow.title%",
                "icon": "$(target)"
            },
            {
                "command": "extension.openLsdynaLargeFileViewer",
                "title": "%commands.openLsdynaLargeFileViewer.title%",
                "category": "LS-DYNA",
                "icon": "$(open-preview)"
            },
            {
                "command": "extension.keywordOptions.apply",
                "title": "%commands.keywordOptions.apply.title%",
                "icon": "$(check)"
            },
            {
                "command": "extension.keywordOptions.reset",
                "title": "%commands.keywordOptions.reset.title%",
                "icon": "$(discard)"
            },
            {
                "command": "extension.keywordOptions.refresh",
                "title": "%commands.keywordOptions.refresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "extension.keywordOptions.openEvidence",
                "title": "%commands.keywordOptions.openEvidence.title%",
                "icon": "$(book)"
            }
        ],
        "keybindings": [
            {
                "command": "extension.jumpToNextKeyword",
                "key": "ctrl+alt+down",
                "when": "editorLangId == 'lsdyna'"
            },
            {
                "command": "extension.jumpToPreviousKeyword",
                "key": "ctrl+alt+up",
                "when": "editorLangId == 'lsdyna'"
            },
            {
                "command": "extension.changeMarks.next",
                "key": "alt+f5",
                "when": "editorTextFocus && editorLangId == 'lsdyna'"
            },
            {
                "command": "extension.changeMarks.previous",
                "key": "shift+alt+f5",
                "when": "editorTextFocus && editorLangId == 'lsdyna'"
            },
            {
                "command": "extension.lsdynaTab",
                "key": "tab",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && !inlineEditIsVisible && !isComposing && !editorTabMovesFocus && !editorHasMultipleSelections && !lsdyna.inlineEditChoiceActive && lsdyna.shouldAlignTab && config.lsdyna.enableTabNavigation"
            },
            {
                "command": "extension.lsdynaShiftTab",
                "key": "shift+tab",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible && !inlineEditIsVisible && !isComposing && !editorTabMovesFocus && !editorHasMultipleSelections && !lsdyna.inlineEditChoiceActive && lsdyna.shouldAlignTab && config.lsdyna.enableTabNavigation"
            },
            {
                "command": "extension.lsdynaSelectCell",
                "key": "shift+alt+right",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.shouldAlignTab && config.lsdyna.enableTabNavigation"
            },
            {
                "command": "extension.lsdynaCellDeleteRight",
                "key": "delete",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.cellEditActive && !lsdyna.inlineEditChoiceActive && !editorHasMultipleSelections && config.lsdyna.enableCellEditProtect"
            },
            {
                "command": "extension.lsdynaCellDeleteLeft",
                "key": "backspace",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.cellEditActive && !lsdyna.inlineEditChoiceActive && !editorHasMultipleSelections && config.lsdyna.enableCellEditProtect"
            },
            {
                "command": "selectNextSuggestion",
                "key": "tab",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.inlineEditChoiceActive && suggestWidgetVisible"
            },
            {
                "command": "selectPrevSuggestion",
                "key": "shift+tab",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.inlineEditChoiceActive && suggestWidgetVisible"
            },
            {
                "command": "acceptSelectedSuggestion",
                "key": "enter",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.inlineEditChoiceActive && suggestWidgetVisible"
            },
            {
                "command": "extension.lsdynaCancelInlineEditChoice",
                "key": "delete",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.inlineEditChoiceActive"
            },
            {
                "command": "extension.lsdynaCancelInlineEditChoice",
                "key": "backspace",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.inlineEditChoiceActive"
            },
            {
                "command": "extension.lsdynaCancelInlineEditChoice",
                "key": "escape",
                "when": "editorTextFocus && editorLangId == 'lsdyna' && lsdyna.inlineEditChoiceActive"
            },
            {
                "command": "extension.lsdynaLineComment",
                "key": "ctrl+/",
                "mac": "cmd+/",
                "when": "editorTextFocus && editorLangId == 'lsdyna'"
            }
        ],
        "configuration": {
            "title": "LS-DYNA",
            "properties": {
                "lsdyna.manualsDir": {
                    "type": "string",
                    "default": "lsdyna_manual_pack",
                    "description": "%config.manualsDir.description%"
                },
                "lsdyna.enableTabNavigation": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableTabNavigation.description%"
                },
                "lsdyna.enableCellEditProtect": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableCellEditProtect.description%"
                },
                "lsdyna.enableFieldHover": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableFieldHover.description%"
                },
                "lsdyna.changeMarks.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.changeMarks.enabled.description%"
                },
                "lsdyna.changeMarks.colorScheme": {
                    "type": "string",
                    "enum": [
                        "adaptive",
                        "orangeBlue",
                        "redBlue",
                        "highContrast",
                        "custom"
                    ],
                    "default": "adaptive",
                    "enumDescriptions": [
                        "%config.changeMarks.colorScheme.enumDescriptions.adaptive%",
                        "%config.changeMarks.colorScheme.enumDescriptions.orangeBlue%",
                        "%config.changeMarks.colorScheme.enumDescriptions.redBlue%",
                        "%config.changeMarks.colorScheme.enumDescriptions.highContrast%",
                        "%config.changeMarks.colorScheme.enumDescriptions.custom%"
                    ],
                    "description": "%config.changeMarks.colorScheme.description%"
                },
                "lsdyna.changeMarks.customUnsavedColor": {
                    "type": "string",
                    "default": "#e2a03a",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "%config.changeMarks.customUnsavedColor.description%"
                },
                "lsdyna.changeMarks.customSavedColor": {
                    "type": "string",
                    "default": "#89d185",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "%config.changeMarks.customSavedColor.description%"
                },
                "lsdyna.changeMarks.maxLineCount": {
                    "type": "number",
                    "default": 100000,
                    "minimum": 1000,
                    "maximum": 5000000,
                    "description": "%config.changeMarks.maxLineCount.description%"
                },
                "lsdyna.changeMarks.debounceMs": {
                    "type": "number",
                    "default": 250,
                    "minimum": 0,
                    "maximum": 5000,
                    "description": "%config.changeMarks.debounceMs.description%"
                },
                "lsdyna.changeMarks.showOverviewRuler": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.changeMarks.showOverviewRuler.description%"
                },
                "lsdyna.changeMarks.showLineBackground": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.changeMarks.showLineBackground.description%"
                },
                "lsdyna.changeMarks.showMinimap": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.changeMarks.showMinimap.description%"
                },
                "lsdyna.navigation.pulseOnJump": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.navigation.pulseOnJump.description%"
                },
                "lsdyna.statusBar.level": {
                    "type": "string",
                    "enum": [
                        "off",
                        "simple",
                        "detail"
                    ],
                    "default": "simple",
                    "enumDescriptions": [
                        "%config.statusBar.level.enumDescriptions.off%",
                        "%config.statusBar.level.enumDescriptions.simple%",
                        "%config.statusBar.level.enumDescriptions.detail%"
                    ],
                    "description": "%config.statusBar.level.description%"
                },
                "lsdyna.health.showFirstRunNotice": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.health.showFirstRunNotice.description%"
                },
                "lsdyna.largeFile.enableRendering": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.largeFile.enableRendering.description%"
                },
                "lsdyna.codeLens.showOnAllKeywords": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.codeLens.showOnAllKeywords.description%"
                },
                "lsdyna.hover.previewMaxLines": {
                    "type": "number",
                    "default": 20,
                    "minimum": 0,
                    "maximum": 500,
                    "description": "%config.hover.previewMaxLines.description%"
                },
                "lsdyna.autoFormat": {
                    "type": "string",
                    "enum": [
                        "onBlur",
                        "disabled"
                    ],
                    "default": "disabled",
                    "enumDescriptions": [
                        "%config.autoFormat.enumDescriptions.onBlur%",
                        "%config.autoFormat.enumDescriptions.disabled%"
                    ],
                    "tags": [
                        "experimental"
                    ],
                    "description": "%config.autoFormat.description%"
                },
                "lsdyna.language": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "zh-cn",
                        "en"
                    ],
                    "default": "auto",
                    "enumDescriptions": [
                        "%config.language.enumDescriptions.auto%",
                        "%config.language.enumDescriptions.zh-cn%",
                        "%config.language.enumDescriptions.en%"
                    ],
                    "description": "%config.language.description%"
                },
                "lsdyna.additionalExtensions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        ".k",
                        ".key",
                        ".dyna"
                    ],
                    "description": "%config.additionalExtensions.description%"
                },
                "lsdyna.scanner.fullScanLargeFiles": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "%config.scanner.fullScanLargeFiles.markdownDescription%"
                },
                "lsdyna.ignoreFormattingKeywords": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "%config.ignoreFormattingKeywords.description%"
                },
                "lsdyna.customValidKeywords": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "*END",
                        "*TITLE",
                        "*CASE_BEGIN",
                        "*CASE_END"
                    ],
                    "description": "%config.customValidKeywords.description%"
                },
                "lsdyna.unknownKeywordSeverity": {
                    "type": "string",
                    "enum": [
                        "error",
                        "warning",
                        "hint",
                        "off"
                    ],
                    "default": "error",
                    "enumDescriptions": [
                        "%config.unknownKeywordSeverity.enumDescriptions.error%",
                        "%config.unknownKeywordSeverity.enumDescriptions.warning%",
                        "%config.unknownKeywordSeverity.enumDescriptions.hint%",
                        "%config.unknownKeywordSeverity.enumDescriptions.off%"
                    ],
                    "description": "%config.unknownKeywordSeverity.description%"
                },
                "lsdyna.warnLowercaseKeyword": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.warnLowercaseKeyword.description%"
                },
                "lsdyna.include.pathCaseCheck": {
                    "type": "string",
                    "enum": [
                        "crossPlatform",
                        "off",
                        "strict"
                    ],
                    "default": "crossPlatform",
                    "enumDescriptions": [
                        "%config.include.pathCaseCheck.enumDescriptions.crossPlatform%",
                        "%config.include.pathCaseCheck.enumDescriptions.off%",
                        "%config.include.pathCaseCheck.enumDescriptions.strict%"
                    ],
                    "description": "%config.include.pathCaseCheck.description%"
                },
                "lsdyna.cache.memoryMaxMiB": {
                    "type": "number",
                    "default": 48,
                    "minimum": 16,
                    "maximum": 64,
                    "description": "%config.cache.memoryMaxMiB.description%"
                },
                "lsdyna.cache.projectSnapshotDiskMaxMiB": {
                    "type": "number",
                    "default": 256,
                    "minimum": 32,
                    "maximum": 256,
                    "description": "%config.cache.projectSnapshotDiskMaxMiB.description%"
                },
                "lsdyna.cache.fileScanDiskMaxMiB": {
                    "type": "number",
                    "default": 256,
                    "minimum": 32,
                    "maximum": 256,
                    "description": "%config.cache.fileScanDiskMaxMiB.description%"
                },
                "lsdyna.cache.fileScanMemoryMaxMiB": {
                    "type": "number",
                    "default": 16,
                    "minimum": 4,
                    "maximum": 16,
                    "description": "%config.cache.fileScanMemoryMaxMiB.description%"
                },
                "lsdyna.cache.maxAgeDays": {
                    "type": "number",
                    "default": 30,
                    "minimum": 1,
                    "maximum": 30,
                    "description": "%config.cache.maxAgeDays.description%"
                },
                "lsdyna.clearAutoIndentOnEnter": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.clearAutoIndentOnEnter.description%"
                },
                "lsdyna.keywordManager.allowUnauditedCatalog": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.keywordManager.allowUnauditedCatalog.description%"
                }
            }
        },
        "menus": {
            "view/title": [
                {
                    "command": "extension.searchIncludeTree",
                    "when": "view == lsdynaIncludeTree",
                    "group": "navigation@1"
                },
                {
                    "command": "extension.scanIncludeTree",
                    "when": "view == lsdynaIncludeTree",
                    "group": "navigation@2"
                },
                {
                    "command": "extension.searchKeywordIndex",
                    "when": "view == lsdynaKeywordIndex",
                    "group": "navigation@1"
                },
                {
                    "command": "extension.keywordIndexChooseScope",
                    "when": "view == lsdynaKeywordIndex",
                    "group": "navigation@2"
                },
                {
                    "command": "extension.keywordIndexRefresh",
                    "when": "view == lsdynaKeywordIndex",
                    "group": "navigation@3"
                },
                {
                    "command": "extension.entityReferences.refresh",
                    "when": "view == lsdynaEntityReferences",
                    "group": "navigation@1"
                },
                {
                    "command": "extension.keywordIndexChooseLayout",
                    "when": "view == lsdynaKeywordIndex",
                    "group": "1_layout@1"
                },
                {
                    "command": "extension.keywordIndexToggleFollow",
                    "when": "view == lsdynaKeywordIndex",
                    "group": "navigation@4"
                }
            ],
            "editor/context": [
                {
                    "command": "extension.selectKeyword",
                    "when": "editorLangId == 'lsdyna'",
                    "group": "lsdyna@2"
                },
                {
                    "command": "extension.lsdynaChooseKeywordOptions",
                    "when": "editorLangId == 'lsdyna'",
                    "group": "lsdyna@3"
                },
                {
                    "command": "extension.openIncludeFile",
                    "when": "editorLangId == 'lsdyna' && lsdyna.onIncludeLine",
                    "group": "lsdyna@4"
                },
                {
                    "command": "extension.queryLsdynaEntityId",
                    "when": "editorLangId == 'lsdyna' || resourceExtname == '.k' || resourceExtname == '.key' || resourceExtname == '.dyna'",
                    "group": "lsdyna@0.75"
                },
                {
                    "command": "extension.entityReferences.refresh",
                    "when": "editorLangId == 'lsdyna'",
                    "group": "lsdyna@0.8"
                },
                {
                    "command": "extension.lsdynaLineComment",
                    "when": "editorLangId == 'lsdyna'",
                    "group": "lsdyna@0"
                },
                {
                    "command": "extension.pickOfficialFieldValue",
                    "when": "editorLangId == 'lsdyna' && lsdyna.hasOfficialFieldChoices",
                    "group": "lsdyna@0.5"
                },
                {
                    "command": "extension.lsdynaFormatSelection",
                    "when": "editorLangId == 'lsdyna'",
                    "group": "lsdyna@1"
                }
            ],
            "editor/title": [
                {
                    "command": "extension.jumpToNextKeyword",
                    "when": "editorLangId == 'lsdyna'",
                    "group": "navigation"
                },
                {
                    "command": "extension.jumpToPreviousKeyword",
                    "when": "editorLangId == 'lsdyna'",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "extension.openToSide",
                    "when": "view == lsdynaIncludeTree && viewItem == file || view == lsdynaKeywordIndex && viewItem == file",
                    "group": "inline"
                },
                {
                    "command": "extension.revealInExplorer",
                    "when": "view == lsdynaIncludeTree && viewItem == file || view == lsdynaKeywordIndex && viewItem == file",
                    "group": "navigation"
                },
                {
                    "command": "extension.copyIncludeTreeItem",
                    "when": "view == lsdynaIncludeTree && (viewItem == file || viewItem == file-missing)",
                    "group": "1_copy@1"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "lsdyna.largeFileViewer",
                "displayName": "%customEditors.largeFileViewer.displayName%",
                "selector": [
                    {
                        "filenamePattern": "*.key"
                    },
                    {
                        "filenamePattern": "*.k"
                    },
                    {
                        "filenamePattern": "*.dyna"
                    }
                ],
                "priority": "option"
            }
        ]
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0",
        "vscode-languageserver": "^10.1.0",
        "vscode-messenger": "^0.6.1",
        "vscode-messenger-common": "^0.6.1"
    },
    "overrides": {
        "serialize-javascript": "^7.0.6",
        "diff": "^8.0.4"
    }
}
