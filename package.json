{
    "name": "dynasense",
    "displayName": "DynaSense",
    "description": "%extension.description%",
    "publisher": "hqyyqh",
    "author": "hqyyqh",
    "license": "SEE LICENSE IN LICENSE",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/hqyyqh/vscode-lsdyna"
    },
    "icon": "images/extension-icon.png",
    "version": "3.2.0",
    "engines": {
        "vscode": "^1.100.0"
    },
    "activationEvents": [
        "onLanguage:lsdyna",
        "onLanguage:lsprepost-command-file",
        "onCommand:extension.openIncludeFile",
        "onCommand:extension.selectKeyword",
        "onCommand:extension.lsdynaShiftTab",
        "onCommand:extension.lsdynaSelectCell",
        "onCommand:extension.lsdynaFormatSelection",
        "onCommand:extension.lsdynaLineComment",
        "onCommand:extension.jumpToNextKeyword",
        "onCommand:extension.jumpToPreviousKeyword",
        "onCommand:extension.scanIncludeTree",
        "onCommand:extension.scanKeywordIndex",
        "onCommand:extension.searchIncludeTree",
        "onCommand:extension.searchKeywordIndex",
        "onCommand:extension.keywordIndexSetLocal",
        "onCommand:extension.keywordIndexChooseScope",
        "onCommand:extension.keywordIndexRefresh",
        "onCommand:extension.addCustomValidKeyword",
        "onCommand:extension.manageCustomValidKeywords",
        "onCommand:extension.addAllUnknownKeywordsInFile",
        "onCommand:extension.pickSimilarKeywordHelp",
        "onCommand:extension.openToSide",
        "onCommand:extension.revealInExplorer",
        "onCommand:extension.copyIncludeTreeItem",
        "onCommand:extension.openManual",
        "onCommand:extension.manual.openReader",
        "onCommand:extension.manual.openCurrentKeyword",
        "onCommand:extension.openLsdynaReferenceDefinition",
        "onCommand:extension.selectMainDeckContext",
        "onCommand:extension.lsdynaChooseKeywordOptions",
        "onCommand:extension.configureManualsDir",
        "onCommand:extension.showHealthStatus",
        "onCommand:extension.showFieldHelpEnglish",
        "onCommand:extension.lsdynaStatusDashboard",
        "onCommand:extension.muteFieldHoverSession",
        "onCommand:extension.disableFieldHover",
        "onCommand:extension.toggleFieldHover",
        "onCommand:extension.lsdynaTab",
        "onCommand:extension.lsdynaCellDeleteLeft",
        "onCommand:extension.lsdynaCellDeleteRight",
        "onCommand:extension.changeMarks.next",
        "onCommand:extension.changeMarks.previous",
        "onCommand:extension.changeMarks.resetOrigin",
        "onCommand:extension.changeMarks.diffSinceOpened",
        "onCommand:extension.changeMarks.diffUnsaved",
        "onCommand:extension.searchLsdynaReferenceInWorkspace",
        "onCommand:extension.queryLsdynaEntityId",
        "onCommand:extension.entityReferences.refresh",
        "onCommand:extension.entityReferences.pin",
        "onCommand:extension.entityReferences.unpin",
        "onCommand:extension.entityReferences.remove",
        "onCommand:extension.entityReferences.clear",
        "onCommand:extension.entityReferences.next",
        "onCommand:extension.entityReferences.previous",
        "onCommand:extension.entityReferences.openSide",
        "onCommand:extension.entityReferences.openCurrent",
        "onCommand:extension.clearProjectIndexCaches",
        "onCommand:extension.checkKeywordStructure",
        "onCommand:extension.addVerifiedConditionalCards",
        "onCommand:extension.pickOfficialFieldValue",
        "onCommand:extension.keywordIndexChooseLayout",
        "onCommand:extension.keywordIndexToggleFollow",
        "onCommand:extension.openLsdynaLargeFileViewer",
        "onCustomEditor:lsdyna.largeFileViewer",
        "onCommand:extension.keywordOptions.apply",
        "onCommand:extension.keywordOptions.reset",
        "onCommand:extension.keywordOptions.refresh",
        "onCommand:extension.keywordOptions.openEvidence"
    ],
    "main": "./out/client/bootstrap.js",
    "categories": [
        "Programming Languages"
    ],
    "scripts": {
        "compile": "tsc -p . && npm run build:runtime-data",
        "build:field-help-delta": "node scripts/build/generate-field-help-zh-delta.cjs",
        "check:contracts": "node scripts/release/validate-public-source-contracts.cjs",
        "check:field-data-zh": "python scripts/build/keywords/validate_field_data_translation.py --check-content && python scripts/build/keywords/audit_field_data_quality.py",
        "check:native-help-zh": "python scripts/build/keywords/validate_native_help_translation.py",
        "check:manual-semantics-zh": "python scripts/build/keywords/validate_manual_semantics_translation.py",
        "check:package-contents": "node scripts/release/package-hover-release.cjs out/package-content-check.vsix",
        "build:webview": "vite build --config webview/manual-reader/vite.config.ts && vite build --config webview/entity-references/vite.config.ts && vite build --config webview/keyword-options/vite.config.ts && vite build --config webview/large-file-viewer/vite.config.ts",
        "typecheck:webview": "tsc --noEmit -p webview/manual-reader/tsconfig.json && tsc --noEmit -p webview/entity-references/tsconfig.json && tsc --noEmit -p webview/keyword-options/tsconfig.json && tsc --noEmit -p webview/large-file-viewer/tsconfig.json",
        "test:webview": "npm run typecheck:webview && vitest run --config webview/manual-reader/vitest.config.ts && vitest run --config webview/entity-references/vitest.config.ts && vitest run --config webview/keyword-options/vitest.config.ts && vitest run --config webview/large-file-viewer/vitest.config.ts",
        "pretest": "npm run build:webview",
        "watch": "tsc -watch -p .",
        "test": "npm run compile && npm run test:unit && npm run test:data",
        "test:editor-safety:host": "npm run compile && node scripts/host/run-editor-safety-extension-host.cjs",
        "test:editor-safety:close-dialog": "npm run compile && node scripts/host/run-editor-safety-close-dialog.cjs",
        "test:editor-safety:vehicles": "npm run compile && node scripts/host/run-editor-safety-vehicle-host.cjs",
        "test:editor-safety:large-files": "npm run compile && node scripts/host/run-editor-safety-large-file-host.cjs",
        "test:scanner-benchmark": "npm run compile && mocha --require test/support/register-out.js test/core/scanner/scannerBenchmark.test.js",
        "package": "npm run vscode:prepublish && node scripts/release/package-hover-release.cjs",
        "vscode:prepublish": "npm run build:webview && npm run typecheck:webview && npm run compile",
        "build:field-schema-runtime": "node scripts/build/generate-field-schema-runtime.cjs",
        "build:field-help-runtime": "node scripts/build/generate-field-help-runtime.cjs",
        "build:runtime-data": "node scripts/release/build-public-runtime-data.cjs",
        "build": "npm run vscode:prepublish",
        "data:build": "node scripts/build/keywords/data.cjs --build",
        "data:update": "node scripts/build/keywords/data.cjs --update",
        "data:check": "node scripts/build/keywords/data.cjs --check",
        "update:source-manifest": "node scripts/release/update-source-manifest.cjs",
        "test:unit": "mocha --require test/support/register-out.js \"test/**/*.test.js\" --ignore \"test/scripts/native/**\"",
        "test:data": "node --test test/scripts/build/keywords/data.test.cjs"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/vscode": "^1.100.0",
        "@vitejs/plugin-react": "^6.0.3",
        "@vscode-elements/elements": "^2.5.1",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "0.28.2",
        "github-markdown-css": "^5.9.0",
        "jsdom": "^29.1.1",
        "katex": "^0.16.47",
        "mocha": "^11.7.6",
        "ovsx": "^1.0.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1",
        "typescript": "^6.0.3",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "vscode-messenger-webview": "^0.6.1"
    },
    "contributes": {
        "colors": [
            {
                "id": "lsdyna.changeMarks.unsaved",
                "description": "%colors.changeMarks.unsaved.description%",
                "defaults": {
                    "dark": "#e2a03a",
                    "light": "#b8860b",
                    "highContrast": "#ffcc00",
                    "highContrastLight": "#8b6914"
                }
            },
            {
                "id": "lsdyna.changeMarks.saved",
                "description": "%colors.changeMarks.saved.description%",
                "defaults": {
                    "dark": "#89d185",
                    "light": "#2e7d32",
                    "highContrast": "#3ddc84",
                    "highContrastLight": "#0b6a0b"
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "lsdyna-includes",
                    "title": "%viewsContainers.lsdyna-includes.title%",
                    "icon": "images/activitybar-icon.svg"
                }
            ]
        },
        "views": {
            "lsdyna-includes": [
                {
                    "id": "lsdynaIncludeTree",
                    "name": "%views.lsdynaIncludeTree.name%"
                },
                {
                    "id": "lsdynaKeywordIndex",
                    "name": "%views.lsdynaKeywordIndex.name%"
                },
                {
                    "type": "webview",
                    "id": "lsdynaManuals",
                    "name": "%views.lsdynaManuals.name%"
                },
                {
                    "type": "webview",
                    "id": "lsdynaEntityReferences",
                    "name": "%views.lsdynaEntityReferences.name%"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "lsdynaIncludeTree",
                "contents": "%viewsWelcome.lsdynaIncludeTree.contents%"
            },
            {
                "view": "lsdynaKeywordIndex",
                "contents": "%viewsWelcome.lsdynaKeywordIndex.contents%"
            }
        ],
        "configurationDefaults": {
            "[lsdyna]": {
                "editor.quickSuggestions": {
                    "other": false,
                    "comments": false,
                    "strings": false
                },
                "editor.suggest.showWords": false,
                "editor.wordBasedSuggestions": "off",
                "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",<>/?",
                "editor.wordWrap": "off",
                "editor.guides.indentation": false,
                "editor.renderIndentGuides": false,
                "editor.renderWhitespace": "all",
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "editor.rulers": [
                    10,
                    20,
                    30,
                    40,
                    50,
                    60,
                    70,
                    80
                ]
            }
        },
        "languages": [
            {
                "id": "lsdyna",
                "aliases": [
                    "LS-Dyna",
                    "lsdyna"
                ],
                "extensions": [
                    ".k",
                    ".key",
                    ".dyna",
                    ".asc"
                ],
                "icon": {
                    "light": "./images/ls.svg",
                    "dark": "./images/ls.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "lsprepost-command-file",
                "aliases": [
                    "LS-PrePost Command File"
                ],
                "extensions": [
                    ".cfile"
                ],
                "configuration": "./language-configuration-lspp-cfile.json"
            }
        ],
        "grammars": [
            {
                "language": "lsdyna",
                "scopeName": "source.lsdyna",
                "path": "./syntaxes/lsdyna.tmLanguage.json"
            },
            {
                "language": "lsprepost-command-file",
                "scopeName": "source.lsprepost-command-file",
                "path": "./syntaxes/lspp-cfile.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "extension.openIncludeFile",
                "title": "%commands.openIncludeFile.title%"
            },
            {
                "command": "extension.selectKeyword",
                "title": "%commands.selectKeyword.title%"
            },
            {
                "command": "extension.jumpToNextKeyword",
                "title": "%commands.jumpToNextKeyword.title%",
                "icon": "$(arrow-down)"
            },
            {
                "command": "extension.jumpToPreviousKeyword",
                "title": "%commands.jumpToPreviousKeyword.title%",
                "icon": "$(arrow-up)"
            },
            {
                "command": "extension.scanIncludeTree",
                "title": "%commands.scanIncludeTree.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "extension.scanKeywordIndex",
                "title": "%commands.scanKeywordIndex.title%",
                "icon": "$(list-tree)"
            },
            {
                "command": "extension.searchIncludeTree",
                "title": "%commands.searchIncludeTree.title%",
                "icon": "$(search)"
            },
            {
                "command": "extension.searchKeywordIndex",
                "title": "%commands.searchKeywordIndex.title%",
                "icon": "$(search)"
            },
            {
                "command": "extension.keywordIndexChooseScope",
                "title": "%commands.keywordIndexChooseScope.title%",
                "icon": "$(scope)"
            },
            {
                "command": "extension.keywordIndexRefresh",
                "title": "%commands.keywordIndexRefresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "extension.keywordIndexSetLocal",
                "title": "%commands.keywordIndexSetLocal.title%",
                "icon": "$(file-text)"
            },
            {
                "command": "extension.addCustomValidKeyword",
                "title": "%commands.addCustomValidKeyword.title%"
            },
            {
                "command": "extension.manageCustomValidKeywords",
                "title": "%commands.manageCustomValidKeywords.title%"
            },
